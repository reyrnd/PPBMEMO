rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if request.auth.uid == uid;
    }

    match /invites/{code} {
      allow get, create: if signedIn();   // sengaja tanpa list
    }

    match /workspaces/{wsId} {
      function ws() {
        return get(/databases/$(database)/documents/workspaces/$(wsId)).data;
      }
      function isMember() {
        return signedIn() && request.auth.uid in ws().memberIds;
      }
      function isOwner() {
        return signedIn() && ws().ownerId == request.auth.uid;
      }

      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if (signedIn() && request.auth.uid in resource.data.memberIds)
        || (signedIn()
            && request.auth.uid in request.resource.data.memberIds
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['memberIds', 'members', 'memberInitials']));
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerId;

      match /memos/{memoId} {
        allow read: if isMember();

        allow create: if isMember()
          && request.resource.data.authorId == request.auth.uid;

        // pembuat boleh mengubah semuanya; anggota lain hanya field kolaborasi
        allow update: if isMember() && (
          (resource.data.get('authorId', '') == request.auth.uid
            && request.resource.data.authorId == request.auth.uid)
          || request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['bookmarkedBy', 'boardX', 'boardY', 'boardStatus'])
        );

        // pembuat memo, atau pemilik workspace (saat workspace dihapus)
        allow delete: if isMember() && (
          resource.data.get('authorId', '') == request.auth.uid || isOwner()
        );

        match /comments/{commentId} {
          allow read: if isMember();
          allow create: if isMember()
            && request.resource.data.authorId == request.auth.uid;
          allow update, delete: if isMember() && (
            resource.data.get('authorId', '') == request.auth.uid || isOwner()
          );
        }
      }

      match /activities/{activityId} {
        allow read, create: if isMember();
        allow delete: if isOwner();
      }
    }
  }
}